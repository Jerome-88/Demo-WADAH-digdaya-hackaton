# Supabase (Settings → API in your Supabase project dashboard)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Double-check these against Google's current model catalog before deploying —
# names change over time. Free tier uses the cheaper/lighter model, Premium
# uses the fuller one, per PRD section 4.5.
GEMINI_MODEL_FREE=gemini-3.1-flash-lite
GEMINI_MODEL_PREMIUM=gemini-3.5-flash

# App
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
